# LightHouse Enterprise: environment variables (placeholders only)
#
# Copy to `.env` for local development; `.env` is gitignored. Never commit real values.
# Variables marked SECRET hold credentials. Their real production values are entered
# only in the hosting platform's secret store or the Supabase dashboard, never in a
# file, a commit, a ticket or a chat. Placeholders in <angle brackets> must be replaced.

# ---------------------------------------------------------------------------
# Server (server/)
# ---------------------------------------------------------------------------

# SECRET (contains the database password).
# Postgres URL the API uses to serve requests. Use a dedicated login role created with
# NOINHERIT whose only privilege is membership of `lh_app` (the server switches to
# `lh_app` inside every transaction). Never `postgres` or `service_role` in production:
# those can bypass row-level security if a code path ever forgot to switch role.
LH_DATABASE_URL=postgresql://<app_role>:<password>@<host>:5432/<database>

# Not secret. Supabase Auth JWKS endpoint used to verify console session tokens.
LH_JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Not secret. Expected `aud` and `iss` claims of those tokens.
LH_JWT_AUDIENCE=authenticated
LH_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Not secret. Developer mode. Leave `false`; set `true` only on a developer machine,
# never on a deployed environment.
LH_DEV=false

# SECRET. Anthropic API key. Leave this EMPTY in every file.
# The real key is entered only in the hosting platform's dashboard as a runtime secret
# of the server container, never in a file. Local development and tests use the
# fixture model and need no key. Development and production keys are separate, each
# in its own Anthropic workspace with its own spend limit.
ANTHROPIC_API_KEY=

# Tests only. Superuser URL of an EMPTY, throwaway PostgreSQL 16 server; the test suite
# creates and drops what it needs. CI sets this to its own service container.
# Example for a local disposable container started with the image's default password:
# LH_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Web console (web/)
# ---------------------------------------------------------------------------

# Not secret. Base URL of the LightHouse API.
# Every VITE_* variable is compiled into the public JavaScript bundle and can be read
# by anyone who loads the console. Never put a key, token or password in a VITE_*
# variable.
VITE_API_BASE_URL=http://localhost:8000/api
